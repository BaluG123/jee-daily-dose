          {"id": "B", "text": {"en": "$9.8\\,\\text{m/s}^2$", "hi": "$9.8\\,\\text{m/s}^2$"}},
          {"id": "C", "text": {"en": "Infinite", "hi": "अनंत"}},
          {"id": "D", "text": {"en": "Double the surface value", "hi": "सतह के मान का दोगुना"}}
